<aura:component
    description="ChangeProjectMember"
    controller="ChangeProjectMemberController"
    implements="force:hasRecordId,force:lightningQuickActionWithoutHeader,flexipage:availableForAllPageTypes">

    <!-- 모달 크기 조정 -->
    <aura:html tag="style">
        .slds-modal__container {
            min-width: 702px !important;
            max-width: fit-content !important;
            padding: 0 20px;
        }

        .cuf-content {
            padding: 0 0rem !important;
        }

        .slds-p-around--medium {
            padding: 0rem !important;
        }

        .slds-modal__content {
            overflow-y: hidden !important;
            height: unset !important;
            max-height: unset !important;
        }

        .slds-modal__close {
            display: none !important;
        }
    </aura:html>

    <!-- 초기화 시 프로젝트 멤버 조회-->
    <aura:handler name="init" value="{!this}" action="{!c.fnInit}" />

    <!-- 현재 프로젝트 멤버 목록-->
    <aura:attribute name="ListMember" type="list" default="[]"/>

    <!-- 교체 가능한 직원 목록-->
    <aura:attribute name="ListEmployee" type="list" default="[]"/>

    <!-- 선택한 프로젝트 멤버 Id-->
    <aura:attribute name="ChangedMember" type="String" default=""/>

    <!-- 선택한 직원 Id-->
    <aura:attribute name="SelectedEmployee" type="String" default="" />

    <!-- 직원 선택 영역 노출 여부-->
    <aura:attribute name="ShowEmployeeOption" type="Boolean" default="false"/>



    <div aura:id="modalContainer">

        <section
            role="alertdialog"
            tabindex="-1"
            aria-labelledby="modal-heading-id"
            aria-describedby="modal-content-id-1"
            class="slds-modal slds-fade-in-open"
            aria-modal="true">

            <div class="slds-modal__container">

                <!-- 모달 Header -->
                <header class="modal-header slds-modal__header">
                    <div id="modal-heading-id">
                        프로젝트 멤버 변경
                    </div>
                </header>


                <!-- 모달 Content -->
                <div
                    class="slds-modal__content slds-p-around_medium"
                    id="modal-content-id-1">

                    <div class="slds-p-around_medium">

                        <!-- 프로젝트 멤버 선택 -->
                        <lightning:combobox
                            name="projectMember"
                            label="프로젝트 멤버 선택"
                            value="{!v.ChangedMember}"
                            placeholder="선택"
                            options="{!v.ListMember}"
                            onchange="{!c.fnChangeMember}" />

                        <!-- 직원 선택 노출 -->
                        <aura:if isTrue="{!v.ShowEmployeeOption}">

                            <lightning:combobox
                                name="employee"
                                label="직원 선택"
                                value="{!v.SelectedEmployee}"
                                placeholder="선택"
                                options="{!v.ListEmployee}"
                                onchange="{!c.fnChangeEmployee}" />

                        </aura:if>

                    </div>

                </div>


                <!-- 모달 Footer -->
                <footer class="modal-footer slds-modal__footer">

                    <lightning:button
                        variant="neutral"
                        label="교체"
                        onclick="{!c.fnChange}" />

                    <lightning:button
                        variant="neutral"
                        label="취소"
                        onclick="{!c.fnCancel}" />

                </footer>

            </div>

        </section>

    </div>


</aura:component>